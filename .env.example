########################################
# AI LAB WEB  -  Discord link integration
########################################

# ---- Discord app (Developer Portal -> OAuth2) ----
DISCORD_CLIENT_ID=1538961232252641340

# Developer Portal -> OAuth2 -> "Tajný klíč klienta" -> Resetovat tajný klíč -> Kopírovat
DISCORD_CLIENT_SECRET=

# Developer Portal -> Bot -> "Resetovat token" -> Kopírovat
# NEVER commit this. NEVER expose it to the browser.
DISCORD_BOT_TOKEN=

# Must EXACTLY match a URI registered in Developer Portal -> OAuth2 -> Přesměrování
# dev:
DISCORD_REDIRECT_URI=http://localhost:3000/api/discord/callback
# prod example: https://tvojadomena.sk/api/discord/callback

# ---- Server (guild) + role ----
DISCORD_GUILD_ID=1536436622449451031
DISCORD_SUBSCRIBER_ROLE_ID=1538966404320206898

# ---- Your app ----
APP_URL=http://localhost:3000

# Random 32+ byte secret used to sign the OAuth `state` cookie.
# generate: openssl rand -hex 32
DISCORD_STATE_SECRET=

# Protects /api/cron/sync-roles. generate: openssl rand -hex 32
CRON_SECRET=

# ---- Database ----
DATABASE_URL=postgresql://user:pass@localhost:5432/ailab

# ---- Stripe (optional, for instant grant/revoke on payment events) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

########################################
# GENEROVANIE  -  kredity, fronta, modely
########################################

# ---- Poskytovateľ (aspoň jeden) ----
# kie.ai: jeden účet, desiatky modelov. Toto je predvolená cesta.
# https://kie.ai -> API Key
KIE_API_KEY=

# Priamo Google (Gemini/Imagen). Potrebuje aj úložisko nižšie.
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Priamo OpenAI (gpt-image-*). Potrebuje aj úložisko nižšie.
OPENAI_API_KEY=

# Presmerovanie modelu na iného poskytovateľa BEZ zmeny kódu.
# Formát: {"<id modelu z katalógu>":"<poskytovateľ>:<model u neho>"}
# GEN_MODEL_ROUTING={"gpt-image-2":"openai:gpt-image-1","nano-banana-pro":"google:gemini-3-pro-image"}

# Vývoj a záťažový test: všetko ide na mock, nič nestojí a nič neodchádza von.
# V PRODUKCII NENASTAVUJ.
# GEN_MOCK=1

# ---- Úložisko výstupov ----
# kie.ai vracia hotové odkazy a úložisko nepotrebuje.
# Google/OpenAI vracajú súbor v tele odpovede a bez úložiska sa nespustia.
# Úložisko je zároveň to, kam sa nahrávajú vstupné súbory (/api/upload).
# GEN_STORAGE=supabase
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# GEN_STORAGE_BUCKET=generations
# GEN_UPLOAD_MAX_MB=25

# ---- Priepustnosť ----
# Stropy nie sú fronta. Sú poistka, aby jeden človek nezabral celý účet
# u poskytovateľa. Bežná prevádzka sa ich nedotkne.
# GEN_MAX_INFLIGHT_PER_USER=4        # koľko úloh naraz na jedného človeka
# GEN_MAX_INFLIGHT_TOTAL=200         # strop pre celý web
# GEN_MAX_INFLIGHT_PER_PROVIDER=150  # strop na jedného poskytovateľa
# GEN_MAX_SUBMITS_PER_MINUTE=20      # ochrana proti skriptu
# GEN_MAX_ATTEMPTS=3                 # koľkokrát skúsiť odoslať
# GEN_JOB_TIMEOUT_MINUTES=25         # po tomto úlohu zavrieme a vrátime kredity

# ---- Kredity ----
# GEN_CREDIT_USD=0.005               # hodnota kreditu (len na zobrazenie)
# GEN_MARKUP_PCT=0                   # prirážka nad nákupnú cenu
# CREDITS_SIGNUP_BONUS=0             # kredity pre nový účet
# CREDITS_MONTHLY_SUBSCRIBER=0       # mesačné kredity pre predplatiteľa
# CREDIT_PACKS=[{"id":"maly","nazov":"Malý","kredity":1000,"cena_centov":690,"mena":"eur"}]

# Povolené domény vstupných súborov (prázdne = akákoľvek verejná https adresa)
# GEN_ALLOWED_FILE_HOSTS=supabase.co,ailab-web.com
